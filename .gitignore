# Chrome-generated extension artifacts (created when the unpacked extension is
# loaded into the browser — not source, regenerated on load).
_metadata/
*.crx
*.pem
key.pem

# Release zips. These are built with `git archive` and uploaded to the GitHub
# release, so a tracked copy is already published elsewhere. Worse, `git archive`
# packages every tracked file, so a checked-in zip ends up inside the next
# release — doubling the download for no reason.
WardenOne-v*.zip

# Machine-local tool settings.
.*/settings.local.json

# Dependencies (none today — guard against future npm/tooling use).
node_modules/
npm-debug.log*
yarn-error.log*

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and scratch
*.log
*.tmp
tmp/

# Local backups of the ad-block engines before the rewrite (not published)
backup/

# Private maintainer notes. These names must never be tracked or published.
CWS-SUBMISSION.md
MAINTAINABILITY.md

# Local publish worktree (nested clone, not source)
.publish/

# Local review notes. Kept out of the repo.
AUDIT-*.html
THEFT-*.md

# Local toast-timing harness. Kept off GitHub deliberately: the page embeds a
# copy of the shipped toast code, and the two files only make sense as a pair,
# so the builder goes with it. The gate skips its checks when they are absent
# rather than failing, so CI stays green without them.
tools/toast-harness.html
tools/build-toast-harness.js
