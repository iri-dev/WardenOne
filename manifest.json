        "https://www.linkedin.com/oauth/v2/authorization*",
        "https://id.twitch.tv/oauth2/authorize*"
      ],
      "js": [
        "oauth-guard.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
