{
  "manifest_version": 3,
  "name": "WardenOne",
  "version": "1.0.2",
  "minimum_chrome_version": "121",
  "incognito": "split",
  "description": "One extension. Every defence. Blocks ads, trackers, phishing, scams, malware downloads & IP grabbers. No account, no telemetry.",
  "homepage_url": "https://iri-dev.github.io/WardenOne/",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "webNavigation",
    "alarms",
    "browsingData",
    "cookies",
    "management",
    "contentSettings",
    "contextMenus",
    "downloads",
    "notifications",
    "offscreen",
    "tabs"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "command-palette": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Shift+O"
      },
      "description": "Open the WardenOne command palette"
    },
    "copy-clean-current-address": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Alt+Shift+U"
      },
      "description": "Copy a clean version of the current page address"
    },
    "element-tool": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Point at something on the page and hide it"
    },
    "open-network-logger": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Open the network logger"
    },
    "pause-site": {
      "description": "Pause or resume WardenOne on this site"
    },
    "scan-site": {
      "description": "Check this site"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WardenOne",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "grabbers",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "adshield_easylist",
        "enabled": true,
        "path": "rules-adshield.json"
      },
      {
        "id": "spotify_media",
        "enabled": true,
        "path": "rules-spotify-media.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules-trackers.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "rules-easyprivacy.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["spotify-silent-1s.mp4"],
      "matches": ["https://open.spotify.com/*"]
    },
    {
      "resources": ["ip-logger-warning.html", "ip-logger-warning.css", "ip-logger-warning.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "spotify-adblock.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "twitch-adblock.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "domain-utils.js",
        "anti-redirect.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.googleapis.com/*",
        "https://accounts.google.com/*",
        "https://*.accounts.google.com/*",
        "https://mail.google.com/*",
        "https://drive.google.com/*",
        "https://docs.google.com/*",
        "https://calendar.google.com/*",
        "https://classroom.google.com/*",
        "https://meet.google.com/*",
        "https://chat.google.com/*",
        "https://myaccount.google.com/*",
        "https://oauth2.googleapis.com/*",
        "https://apis.google.com/*",
        "https://*.ucas.com/*",
        "https://*.ac.uk/*",
        "https://*.edu/*",
        "https://*.edu.au/*",
        "https://*.ac.nz/*",
        "https://*.ac.za/*",
        "https://*.ac.in/*",
        "https://*.edu.sg/*",
        "https://*.edu.hk/*",
        "https://login.microsoftonline.com/*",
        "https://login.live.com/*",
        "https://appleid.apple.com/*",
        "https://okta.com/*",
        "https://*.okta.com/*",
        "https://oktacdn.com/*",
        "https://*.oktacdn.com/*",
        "https://auth0.com/*",
        "https://*.auth0.com/*",
        "https://cdn.auth0.com/*",
        "https://onelogin.com/*",
        "https://*.onelogin.com/*",
        "https://duosecurity.com/*",
        "https://*.duosecurity.com/*",
        "https://openathens.net/*",
        "https://*.openathens.net/*",
        "https://shibboleth.net/*",
        "https://*.shibboleth.net/*",
        "https://pingidentity.com/*",
        "https://*.pingidentity.com/*",
        "https://*.pingone.com/*",
        "https://*.b2clogin.com/*",
        "https://*.ciamlogin.com/*",
        "https://hcaptcha.com/*",
        "https://*.hcaptcha.com/*",
        "https://recaptcha.net/*",
        "https://*.recaptcha.net/*",
        "https://challenges.cloudflare.com/*",
        "https://turnstile.cloudflare.com/*",
        "https://amazoncognito.com/*",
        "https://*.amazoncognito.com/*",
        "https://shopify.com/*",
        "https://*.shopify.com/*",
        "https://github.com/login/oauth/*",
        "https://discord.com/oauth2/*",
        "https://discord.com/api/oauth2/*",
        "https://discordapp.com/oauth2/*",
        "https://discordapp.com/api/oauth2/*",
        "https://www.facebook.com/dialog/oauth*",
        "https://www.facebook.com/*/dialog/oauth*",
        "https://m.facebook.com/dialog/oauth*",
        "https://m.facebook.com/*/dialog/oauth*",
        "https://accounts.spotify.com/authorize*",
        "https://slack.com/oauth/authorize*",
        "https://slack.com/oauth/v2/authorize*",
        "https://slack-gov.com/oauth/authorize*",
        "https://slack-gov.com/oauth/v2/authorize*",
        "https://www.dropbox.com/oauth2/authorize*",
        "https://gitlab.com/oauth/authorize*",
        "https://auth.atlassian.com/authorize*",
        "https://www.linkedin.com/oauth/v2/authorization*",
        "https://id.twitch.tv/oauth2/authorize*",
        "https://www.google.com/recaptcha/*",
        "https://*.arkoselabs.com/*",
        "https://*.funcaptcha.com/*"
      ],
      "js": [
        "fingerprint-realm.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.googleapis.com/*",
        "https://accounts.google.com/*",
        "https://*.accounts.google.com/*",
        "https://mail.google.com/*",
        "https://drive.google.com/*",
        "https://docs.google.com/*",
        "https://calendar.google.com/*",
        "https://classroom.google.com/*",
        "https://meet.google.com/*",
        "https://chat.google.com/*",
        "https://myaccount.google.com/*",
        "https://oauth2.googleapis.com/*",
        "https://apis.google.com/*",
        "https://login.microsoftonline.com/*",
        "https://login.live.com/*",
        "https://appleid.apple.com/*",
        "https://okta.com/*",
        "https://*.okta.com/*",
        "https://oktacdn.com/*",
        "https://*.oktacdn.com/*",
        "https://auth0.com/*",
        "https://*.auth0.com/*",
        "https://cdn.auth0.com/*",
        "https://onelogin.com/*",
        "https://*.onelogin.com/*",
        "https://duosecurity.com/*",
        "https://*.duosecurity.com/*",
        "https://openathens.net/*",
        "https://*.openathens.net/*",
        "https://shibboleth.net/*",
        "https://*.shibboleth.net/*",
        "https://pingidentity.com/*",
        "https://*.pingidentity.com/*",
        "https://*.pingone.com/*",
        "https://*.b2clogin.com/*",
        "https://*.ciamlogin.com/*",
        "https://hcaptcha.com/*",
        "https://*.hcaptcha.com/*",
        "https://recaptcha.net/*",
        "https://*.recaptcha.net/*",
        "https://challenges.cloudflare.com/*",
        "https://turnstile.cloudflare.com/*",
        "https://amazoncognito.com/*",
        "https://*.amazoncognito.com/*",
        "https://shopify.com/*",
        "https://*.shopify.com/*",
        "https://github.com/login/oauth/*",
        "https://discord.com/oauth2/*",
        "https://discord.com/api/oauth2/*",
        "https://discordapp.com/oauth2/*",
        "https://discordapp.com/api/oauth2/*",
        "https://www.facebook.com/dialog/oauth*",
        "https://www.facebook.com/*/dialog/oauth*",
        "https://m.facebook.com/dialog/oauth*",
        "https://m.facebook.com/*/dialog/oauth*",
        "https://accounts.spotify.com/authorize*",
        "https://slack.com/oauth/authorize*",
        "https://slack.com/oauth/v2/authorize*",
        "https://slack-gov.com/oauth/authorize*",
        "https://slack-gov.com/oauth/v2/authorize*",
        "https://www.dropbox.com/oauth2/authorize*",
        "https://gitlab.com/oauth/authorize*",
        "https://auth.atlassian.com/authorize*",
        "https://www.linkedin.com/oauth/v2/authorization*",
        "https://id.twitch.tv/oauth2/authorize*"
      ],
      "js": [
        "content.min.js",
        "permission-chain.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtube.googleapis.com/*"
      ],
      "js": [
        "permission-chain.js",
        "yt-adblock.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "resource-saver.js",
        "animated-image-saver.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "domain-utils.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "twitch-rewind.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "twitch-vod-rewind.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://accounts.google.com/*",
        "https://login.microsoftonline.com/*",
        "https://login.live.com/*",
        "https://github.com/login/oauth/*",
        "https://discord.com/oauth2/*",
        "https://discord.com/api/oauth2/*",
        "https://discordapp.com/oauth2/*",
        "https://discordapp.com/api/oauth2/*",
        "https://appleid.apple.com/auth/authorize*",
        "https://www.facebook.com/dialog/oauth*",
        "https://www.facebook.com/*/dialog/oauth*",
        "https://m.facebook.com/dialog/oauth*",
        "https://m.facebook.com/*/dialog/oauth*",
        "https://accounts.spotify.com/authorize*",
        "https://slack.com/oauth/authorize*",
        "https://slack.com/oauth/v2/authorize*",
        "https://slack-gov.com/oauth/authorize*",
        "https://slack-gov.com/oauth/v2/authorize*",
