   "reason": "Code hosting, Google sign in and mail, and WardenOne's own homepage, which whole sites depend on. gamedrive.org is the owner's reviewed exception.",
   "evidence": "docs/security-feed-exceptions.md (GameDrive)",
   "tests": [
    "tools/test-feed-shared-platforms.js",
