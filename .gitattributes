# Normalize all text files to LF in the repo and working tree, on every platform.
# This keeps the content.min.js byte-exact rebuild check (tools/build-content.js
# --check) from fighting Windows CRLF conversion, and avoids spurious
# whole-file "changes" when switching machines.
* text=auto eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.crx binary
*.pem binary

# Dev-only paths kept out of the packaged Release zip (`git archive`). They stay
# in the repo but don't bloat the download people load unpacked: unminified
# source (the manifest loads content.min.js), the test/build tooling, README
# screenshots, issue templates, and repo-meta / store docs. Every file in the
# zip is there on purpose: LICENSE and NOTICE travel with the work because the
# GPL requires it, and CREDITS.md carries the upstream filter-list attribution.
# Every other document is excluded below, each with its reason; nothing ships
# because no rule happened to remove it (tools/test-package-completeness.js
# checks the archive's document set against this intent).
docs/ export-ignore
# The public website. Belongs on GitHub Pages, not inside the extension package.
site/ export-ignore
tools/ export-ignore
src/ export-ignore
.github/ export-ignore
README.md export-ignore
# Defence in depth for private maintainer notes: the gate rejects these names,
# while export-ignore also keeps them out if somebody force-adds one.
CWS-SUBMISSION.md export-ignore
MAINTAINABILITY.md export-ignore
# The store wants a privacy-policy URL, and the live page is the one that matters.
# Shipping a copy inside the package only gives it somewhere to drift out of date.
PRIVACY.md export-ignore
# Repository documents nothing in the extension reads. The changelog alone was the
# largest non-runtime file in the package (95 KiB); the security policy and the
# support note are for people reading the repository, where GitHub shows them.
CHANGELOG.md export-ignore
SECURITY.md export-ignore
SUPPORT.md export-ignore
.gitignore export-ignore
.gitattributes export-ignore
# A generated ZIP is never part of a release archive, even if it is staged.
WardenOne-store.zip export-ignore
WardenOne-latest.zip export-ignore
WardenOne-v*.zip export-ignore
