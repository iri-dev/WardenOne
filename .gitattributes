# Normalize all text files to LF in the repo and working tree, on every platform.
# This keeps the content.min.js byte-exact rebuild check (tools/build-content.js
# --check) from fighting Windows CRLF conversion, and avoids spurious
# whole-file "changes" when switching machines.
* text=auto eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.crx binary
*.pem binary

# Dev-only paths kept out of the packaged Release zip (`git archive`). They stay
# in the repo but don't bloat the download people load unpacked: unminified
# source (the manifest loads content.min.js), the test/build tooling, README
# screenshots, issue templates, and repo-meta / store docs. LICENSE, CREDITS.md
# and PRIVACY.md are intentionally kept in the zip.
docs/ export-ignore
tools/ export-ignore
src/ export-ignore
.github/ export-ignore
README.md export-ignore
CWS-SUBMISSION.md export-ignore
MAINTAINABILITY.md export-ignore
.gitignore export-ignore
.gitattributes export-ignore
